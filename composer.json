{
    "name": "basis-company/super-sync-client",
    "description": "PHP client for Super Productivity sync server",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Dmitry Krokhin",
            "email": "nekufa@gmail.com"
        }
    ],
    "keywords": [
        "super-productivity",
        "sync",
        "api-client",
        "super-sync"
    ],
    "autoload": {
        "psr-4": {
            "Basis\\SuperSyncClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Basis\\SuperSyncClient\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.2",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "firebase/php-jwt": "^7.0",
        "phpunit/phpunit": "^10.5",
        "symfony/panther": "^2.1"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
